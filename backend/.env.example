# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/krishi_drishti

# JWT Configuration
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Service (Choose one: twilio or msg91)
OTP_SERVICE=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+919xxxxxxxxx

# Alternative: Msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=KRISHI
MSG91_ROUTE=4

# Weather API
WEATHER_API_KEY=your_openweather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
IMD_API_KEY=your_imd_api_key_optional

# Data.gov.in API (for soil and agricultural data)
DATA_GOV_API_KEY=your_data_gov_api_key

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# ML Models
MODEL_DIR=./app/ml_models
CROP_MODEL_PATH=./app/ml_models/crop_suitability_model.pkl
YIELD_MODEL_PATH=./app/ml_models/yield_prediction_model.pkl

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng+hin+tam+tel+kan

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment
ENVIRONMENT=development
DEBUG=True
